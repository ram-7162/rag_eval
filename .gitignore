# pattern       meaning
# ────────────────────────────────────
# .env          name/pattern to ignore
# .venv/        ignore a directory named .venv
# __pycache__/  ignore a directory named __pycache__
# *.pyc         ignore files ending in .pyc

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env